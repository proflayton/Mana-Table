<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>forge</groupId>
        <artifactId>forge</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>forge-api</artifactId>
    <name>Forge Engine API</name>
    <properties>
        <mana.tests.apiCiProfile>false</mana.tests.apiCiProfile>
        <mana.tests.apiTrialProfile>false</mana.tests.apiTrialProfile>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <properties>
                        <property><name>listener</name><value>forge.api.ApiTestListener</value></property>
                    </properties>
                    <systemPropertyVariables>
                        <mana.tests.mode>default</mana.tests.mode>
                        <mana.tests.forkLabel>fork-${surefire.forkNumber}</mana.tests.forkLabel>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ai-release-fixture-launcher</id>
                        <phase>package</phase>
                        <goals><goal>test-jar</goal></goals>
                        <configuration>
                            <finalName>forge-engine</finalName>
                            <classifier>fixtures</classifier>
                            <includes><include>forge/api/AiReleaseFixtureEngine*.class</include></includes>
                            <archive>
                                <addMavenDescriptor>false</addMavenDescriptor>
                                <manifest><mainClass>forge.api.AiReleaseFixtureEngine</mainClass></manifest>
                                <manifestEntries><Class-Path>forge-engine.jar</Class-Path></manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>forge-engine</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>forge.api.DesktopEngine</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>forge.api.CatalogExample</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.2</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <!-- CI opts in; local/default and upstream-module test methods stay serial. -->
        <profile>
            <id>api-ci</id>
            <properties>
                <mana.tests.apiCiProfile>true</mana.tests.apiCiProfile>
                <mana.tests.runRoot>${project.build.directory}/api-test-runs/${mana.tests.trialId}</mana.tests.runRoot>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-test</id>
                                <configuration>
                                    <forkCount>2</forkCount>
                                    <reuseForks>true</reuseForks>
                                    <reportsDirectory>${mana.tests.runRoot}/reports/parallel/fork-${surefire.forkNumber}</reportsDirectory>
                                    <systemPropertyVariables>
                                        <mana.tests.mode>parallel</mana.tests.mode>
                                        <mana.tests.runRoot>${mana.tests.runRoot}</mana.tests.runRoot>
                                        <mana.tests.trialId>${mana.tests.trialId}</mana.tests.trialId>
                                        <mana.tests.sourceRevision>${mana.tests.sourceRevision}</mana.tests.sourceRevision>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-api-ci</id>
                                <phase>process-test-classes</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>node</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../scripts/mana-table/api-test-ci.cjs</argument><argument>prepare</argument>
                                        <argument>--root</argument><argument>${mana.tests.runRoot}</argument>
                                        <argument>--trial-id</argument><argument>${mana.tests.trialId}</argument>
                                        <argument>--source-revision</argument><argument>${mana.tests.sourceRevision}</argument>
                                        <argument>--jdk-runtime</argument><argument>${java.runtime.version}</argument>
                                        <argument>--jdk-vendor</argument><argument>${java.vendor}</argument>
                                        <argument>--jdk-vm</argument><argument>${java.vm.name}</argument>
                                        <argument>--trial-profile</argument><argument>${mana.tests.apiTrialProfile}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Declared after Surefire, including for the extended reactor's mvn test. -->
                            <execution>
                                <id>certify-api-ci</id>
                                <phase>test</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>node</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../scripts/mana-table/api-test-ci.cjs</argument><argument>finish</argument>
                                        <argument>--root</argument><argument>${mana.tests.runRoot}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Opt-in paired measurement; mutually exclusive with normal API CI. -->
        <profile>
            <id>api-test-trial</id>
            <properties>
                <mana.tests.apiTrialProfile>true</mana.tests.apiTrialProfile>
                <mana.tests.trialId>trial</mana.tests.trialId>
                <mana.tests.runRoot>${project.build.directory}/api-test-trials/${mana.tests.trialId}</mana.tests.runRoot>
                <mana.tests.firstMode>serial</mana.tests.firstMode>
                <mana.tests.firstForkCount>1</mana.tests.firstForkCount>
                <mana.tests.secondMode>parallel</mana.tests.secondMode>
                <mana.tests.secondForkCount>2</mana.tests.secondForkCount>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-test</id>
                                <configuration>
                                    <forkCount>${mana.tests.firstForkCount}</forkCount>
                                    <reuseForks>true</reuseForks>
                                    <reportsDirectory>${mana.tests.runRoot}/reports/${mana.tests.firstMode}/fork-${surefire.forkNumber}</reportsDirectory>
                                    <systemPropertyVariables>
                                        <mana.tests.mode>${mana.tests.firstMode}</mana.tests.mode>
                                        <mana.tests.runRoot>${mana.tests.runRoot}</mana.tests.runRoot>
                                        <mana.tests.trialId>${mana.tests.trialId}</mana.tests.trialId>
                                        <mana.tests.sourceRevision>${mana.tests.sourceRevision}</mana.tests.sourceRevision>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                            <execution>
                                <id>api-second-mode</id>
                                <phase>integration-test</phase>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <forkCount>${mana.tests.secondForkCount}</forkCount>
                                    <reuseForks>true</reuseForks>
                                    <reportsDirectory>${mana.tests.runRoot}/reports/${mana.tests.secondMode}/fork-${surefire.forkNumber}</reportsDirectory>
                                    <systemPropertyVariables>
                                        <mana.tests.mode>${mana.tests.secondMode}</mana.tests.mode>
                                        <mana.tests.runRoot>${mana.tests.runRoot}</mana.tests.runRoot>
                                        <mana.tests.trialId>${mana.tests.trialId}</mana.tests.trialId>
                                        <mana.tests.sourceRevision>${mana.tests.sourceRevision}</mana.tests.sourceRevision>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-api-test-trial</id>
                                <phase>process-test-classes</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>node</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../scripts/mana-table/api-test-trial.cjs</argument><argument>prepare</argument>
                                        <argument>--root</argument><argument>${mana.tests.runRoot}</argument>
                                        <argument>--trial-id</argument><argument>${mana.tests.trialId}</argument>
                                        <argument>--source-revision</argument><argument>${mana.tests.sourceRevision}</argument>
                                        <argument>--jdk-runtime</argument><argument>${java.runtime.version}</argument>
                                        <argument>--jdk-vendor</argument><argument>${java.vendor}</argument>
                                        <argument>--jdk-vm</argument><argument>${java.vm.name}</argument>
                                        <argument>--first-mode</argument><argument>${mana.tests.firstMode}</argument>
                                        <argument>--second-mode</argument><argument>${mana.tests.secondMode}</argument>
                                        <argument>--ci-profile</argument><argument>${mana.tests.apiCiProfile}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>finish-api-first-mode</id>
                                <phase>prepare-package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>node</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../scripts/mana-table/api-test-trial.cjs</argument><argument>boundary</argument>
                                        <argument>--root</argument><argument>${mana.tests.runRoot}</argument>
                                        <argument>--mode</argument><argument>${mana.tests.firstMode}</argument>
                                        <argument>--event</argument><argument>end</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>start-api-second-mode</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>node</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../scripts/mana-table/api-test-trial.cjs</argument><argument>boundary</argument>
                                        <argument>--root</argument><argument>${mana.tests.runRoot}</argument>
                                        <argument>--mode</argument><argument>${mana.tests.secondMode}</argument>
                                        <argument>--event</argument><argument>start</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>compare-api-test-trial</id>
                                <phase>verify</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>node</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../scripts/mana-table/api-test-trial.cjs</argument><argument>finish</argument>
                                        <argument>--root</argument><argument>${mana.tests.runRoot}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>api-example</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>headless-catalog-example</id>
                                <phase>verify</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <arguments>
                                        <argument>${project.basedir}/../forge-gui/res</argument>
                                        <argument>Lightning Bolt</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
