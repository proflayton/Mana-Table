    <ProjectReference Include="../Mana.Client/Mana.Client.csproj" />
    <ProjectReference Include="../Mana.Magic/Mana.Magic.csproj" />
    <ProjectReference Include="../Mana.Renderer/Mana.Renderer.csproj" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
